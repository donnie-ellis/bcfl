{
    "headers": [
      {
        "source": "/api/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      }
    ],
    "crons": [
      {
        "path": "/api/cron/updatePlayers",
        "schedule": "0 8 * * 1"
      }
    ]
  }